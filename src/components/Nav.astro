---
import { href } from '../lib/url';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const rel = path.startsWith(base) ? path.slice(base.length) || '/' : path;

const links = [
  { href: '/chart/', label: 'Birth chart' },
  { href: '/zodiac/', label: 'Zodiac' },
  { href: '/sky/', label: 'Sky now' },
  { href: '/learn/', label: 'Learn' },
];

const isActive = (target: string) => {
  const clean = target.replace(/\/+$/, '');
  if (clean === '') return rel === '/';
  return rel === clean || rel.startsWith(clean + '/');
};
---

<header class="site-header" data-nav>
  <div class="container">
    <div class="nav-pill">
      <a class="brand" href={href('/')} aria-label="Astra — home">
        <span class="mark" aria-hidden="true">
          <svg viewBox="0 0 32 32" fill="none">
            <circle cx="16" cy="16" r="13.2" stroke="currentColor" stroke-width="1.1" opacity=".5" />
            <ellipse cx="16" cy="16" rx="13.2" ry="5.4" stroke="currentColor" stroke-width="1.1" opacity=".7" transform="rotate(-28 16 16)" />
            <circle cx="16" cy="16" r="5.1" fill="currentColor" />
            <circle cx="27.4" cy="9.4" r="1.7" fill="currentColor" />
          </svg>
        </span>
        <span class="brand-text">
          <span class="brand-name">Astra</span>
          <span class="brand-sub">astrology</span>
        </span>
      </a>

      <nav class="nav-links" aria-label="Primary">
        {links.map((link) => (
          <a
            href={href(link.href)}
            class:list={['nav-link', { active: isActive(link.href) }]}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))}
      </nav>

      <div class="nav-actions">
        <a class="btn btn-primary btn-sm nav-cta" href={href('/chart/')}>
          Cast your chart
          <span class="arrow" aria-hidden="true">↗</span>
        </a>
        <button
          class="menu-toggle"
          type="button"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
          data-nav-toggle
        >
          <span></span>
          <span></span>
        </button>
      </div>
    </div>

    <div class="mobile-menu" id="mobile-menu" data-mobile-menu hidden>
      <nav aria-label="Mobile">
        {links.map((link) => (
          <a
            href={href(link.href)}
            class:list={['mobile-link', { active: isActive(link.href) }]}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            <span>{link.label}</span>
            <span aria-hidden="true">↗</span>
          </a>
        ))}
      </nav>
      <a class="btn btn-primary btn-block" href={href('/chart/')}>Cast your chart</a>
      <p class="mobile-note">Free · No account · Instant</p>
    </div>
  </div>
</header>

<script is:inline>
  function initNav() {
    document.querySelectorAll('[data-nav-toggle]').forEach(function (button) {
      if (button.dataset.bound === '1') return;
      button.dataset.bound = '1';
      var menu = document.getElementById('mobile-menu');
      var header = button.closest('[data-nav]');
      if (!menu) return;
      function setOpen(open) {
        button.setAttribute('aria-expanded', String(open));
        button.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
        menu.hidden = !open;
        if (header) header.classList.toggle('menu-open', open);
      }
      button.addEventListener('click', function () {
        setOpen(button.getAttribute('aria-expanded') !== 'true');
      });
      menu.querySelectorAll('a').forEach(function (link) {
        link.addEventListener('click', function () { setOpen(false); });
      });
      document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape') setOpen(false);
      });
      window.addEventListener('resize', function () {
        if (window.innerWidth > 900) setOpen(false);
      });
    });
  }
  initNav();
  document.addEventListener('astro:page-load', initNav);
</script>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    padding: 1rem 0;
    pointer-events: none;
  }

  .nav-pill {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 0.5rem 0.55rem 0.5rem 1rem;
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 999px;
    background: rgba(7, 8, 16, 0.82);
    backdrop-filter: blur(18px) saturate(140%);
    -webkit-backdrop-filter: blur(18px) saturate(140%);
    box-shadow: 0 20px 50px -30px rgba(0, 0, 0, 0.9);
    pointer-events: auto;
    transition: border-color 0.4s ease, background 0.4s ease;
  }

  .nav-pill:hover {
    border-color: rgba(255, 255, 255, 0.14);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    flex-shrink: 0;
  }

  .mark {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    color: var(--gold);
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, rgba(232, 196, 124, 0.2), transparent 70%);
    transition: transform 0.8s var(--ease);
  }

  .brand:hover .mark {
    transform: rotate(45deg);
  }

  .mark svg {
    width: 30px;
    height: 30px;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }

  .brand-name {
    font-family: var(--font-serif);
    font-size: 1.42rem;
    letter-spacing: 0.01em;
  }

  .brand-sub {
    margin-top: 2px;
    font-size: 0.52rem;
    font-weight: 600;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.2rem;
    margin-inline: auto;
  }

  .nav-link {
    position: relative;
    padding: 0.48rem 0.85rem;
    border-radius: 999px;
    font-size: 0.86rem;
    color: var(--muted);
    transition: color 0.25s ease, background 0.25s ease;
  }

  .nav-link:hover {
    color: var(--ink);
    background: rgba(255, 255, 255, 0.05);
  }

  .nav-link.active {
    color: var(--gold-bright);
  }

  .nav-link.active::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 2px;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--gold);
    transform: translateX(-50%);
    box-shadow: 0 0 8px 1px rgba(232, 196, 124, 0.8);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-shrink: 0;
  }

  .menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.03);
    padding: 0 11px;
  }

  .menu-toggle span {
    display: block;
    height: 1.2px;
    width: 100%;
    background: var(--ink);
    transition: transform 0.3s var(--ease), opacity 0.3s ease;
  }

  .menu-open .menu-toggle span:first-child {
    transform: translateY(3.1px) rotate(45deg);
  }

  .menu-open .menu-toggle span:last-child {
    transform: translateY(-3.1px) rotate(-45deg);
  }

  .mobile-menu {
    margin-top: 0.6rem;
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: 24px;
    background: rgba(7, 8, 16, 0.94);
    backdrop-filter: blur(24px);
    pointer-events: auto;
    animation: fade-up 0.35s var(--ease) both;
  }

  .mobile-menu[hidden] {
    display: none;
  }

  .mobile-menu nav {
    display: flex;
    flex-direction: column;
    margin-bottom: 0.9rem;
  }

  .mobile-link {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.8rem 0.6rem;
    border-bottom: 1px solid var(--line-soft);
    font-size: 1.02rem;
    color: var(--muted);
  }

  .mobile-link.active {
    color: var(--gold-bright);
  }

  .mobile-note {
    margin-top: 0.8rem;
    text-align: center;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--faint);
  }

  @media (max-width: 900px) {
    .nav-links {
      display: none;
    }
    .menu-toggle {
      display: flex;
    }
    .nav-cta {
      display: none;
    }
    .nav-pill {
      gap: 0.75rem;
    }
    .brand {
      margin-right: auto;
    }
  }

  @media (max-width: 420px) {
    .brand-sub {
      display: none;
    }
  }
</style>
