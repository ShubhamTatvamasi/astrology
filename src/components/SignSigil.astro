---
import { SIGNS, type Sign } from '../data/signs';

interface Props {
  sign: Sign;
}

const { sign } = Astro.props;
const index = SIGNS.findIndex((s) => s.slug === sign.slug);

const colors: Record<string, string> = {
  Fire: '#ff8a5c',
  Earth: '#7fcf9d',
  Air: '#8fb8ff',
  Water: '#b79dff',
};
const color = colors[sign.element]!;

let seed = sign.slug.split('').reduce((acc, ch) => acc + ch.charCodeAt(0), 17);
const rand = () => {
  seed = (seed * 9301 + 49297) % 233280;
  return seed / 233280;
};

const stars = Array.from({ length: 34 }, () => {
  const angle = rand() * Math.PI * 2;
  const radius = 34 + rand() * 128;
  return {
    x: (220 + Math.cos(angle) * radius).toFixed(1),
    y: (220 + Math.sin(angle) * radius).toFixed(1),
    r: (0.6 + rand() * 1.3).toFixed(2),
    o: (0.2 + rand() * 0.5).toFixed(2),
  };
});

const lines = [
  [0, 3],
  [3, 7],
  [7, 10],
  [10, 14],
  [14, 19],
  [19, 23],
  [23, 26],
  [26, 30],
  [30, 4],
  [4, 12],
];
---

<div class="sigil" style={`--c:${color}`} aria-hidden="true">
  <div class="aura"></div>
  <svg viewBox="0 0 440 440" fill="none">
    <defs>
      <radialGradient id={`sigil-bg-${sign.slug}`} cx="50%" cy="46%" r="58%">
        <stop offset="0%" stop-color={color} stop-opacity=".16" />
        <stop offset="55%" stop-color={color} stop-opacity=".04" />
        <stop offset="100%" stop-color={color} stop-opacity="0" />
      </radialGradient>
      <radialGradient id={`sigil-core-${sign.slug}`} cx="40%" cy="34%" r="70%">
        <stop offset="0%" stop-color="#141428" />
        <stop offset="100%" stop-color="#080914" />
      </radialGradient>
      <filter id={`sigil-glow-${sign.slug}`} x="-70%" y="-70%" width="240%" height="240%">
        <feGaussianBlur stdDeviation="6" />
      </filter>
      <radialGradient id={`sigil-disc-${sign.slug}`} cx="50%" cy="44%" r="56%">
        <stop offset="0%" stop-color="#16132b" />
        <stop offset="65%" stop-color="#0c0d1a" />
        <stop offset="100%" stop-color="#070812" />
      </radialGradient>
    </defs>

    <circle cx="220" cy="220" r="210" fill={`url(#sigil-disc-${sign.slug})`} class="disc" />
    <circle cx="220" cy="220" r="210" fill={`url(#sigil-bg-${sign.slug})`} />
    <circle cx="220" cy="220" r="206" stroke="rgba(255,255,255,.07)" stroke-dasharray="1 8" class="spin-slow" />
    <circle cx="220" cy="220" r="188" stroke="rgba(255,255,255,.09)" />
    <circle cx="220" cy="220" r="150" stroke={color} stroke-opacity=".16" />
    <circle cx="220" cy="220" r="112" stroke="rgba(232,196,124,.14)" stroke-dasharray="2 6" class="spin-reverse" />

    <g class="constellation">
      <g stroke={color} stroke-opacity=".22" stroke-width=".7">
        {lines.map(([a, b]) => (
          <line x1={stars[a]!.x} y1={stars[a]!.y} x2={stars[b]!.x} y2={stars[b]!.y} />
        ))}
      </g>
      {stars.map((star, i) => (
        <circle
          cx={star.x}
          cy={star.y}
          r={star.r}
          fill={i % 5 === 0 ? '#f7e3b0' : color}
          opacity={star.o}
          class="star"
          style={`--d:${i * 0.25}s`}
        />
      ))}
    </g>

    <g class="zodiac-ring">
      {SIGNS.map((item, i) => {
        const angle = ((i * 30 - 90) * Math.PI) / 180;
        const x = (220 + Math.cos(angle) * 188).toFixed(1);
        const y = (220 + Math.sin(angle) * 188).toFixed(1);
        return (
          <text
            x={x}
            y={y}
            text-anchor="middle"
            dominant-baseline="central"
            fill={i === index ? color : 'rgba(237,234,246,.28)'}
            class:list={['z-glyph', { current: i === index }]}
          >
            {item.glyph}
          </text>
        );
      })}
    </g>

    <circle cx="220" cy="220" r="82" fill={`url(#sigil-core-${sign.slug})`} stroke={color} stroke-opacity=".35" />
    <circle cx="220" cy="220" r="82" fill={color} opacity=".08" filter={`url(#sigil-glow-${sign.slug})`} />
    <text x="220" y="224" text-anchor="middle" dominant-baseline="central" fill={color} class="center-glyph">
      {sign.glyph}
    </text>

    <circle cx="220" cy="220" r="220" stroke="rgba(232,196,124,.1)" />
  </svg>
</div>

<style>
  .sigil {
    position: relative;
    width: 100%;
    max-width: 540px;
    margin-inline: auto;
    aspect-ratio: 1;
    animation: sigil-float 9s ease-in-out infinite;
  }

  .aura {
    position: absolute;
    inset: 18%;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--c) 30%, transparent), transparent 68%);
    filter: blur(42px);
    animation: aura-pulse 8s ease-in-out infinite;
  }

  .disc {
    filter: drop-shadow(0 30px 55px rgba(18, 13, 35, 0.3));
  }

  svg {
    position: relative;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .spin-slow {
    transform-origin: 220px 220px;
    animation: spin 150s linear infinite;
  }

  .spin-reverse {
    transform-origin: 220px 220px;
    animation: spin-reverse 90s linear infinite;
  }

  .z-glyph {
    font-family: var(--font-glyph);
    font-size: 15px;
    transition: fill 0.3s ease;
  }

  .z-glyph.current {
    font-size: 22px;
  }

  .center-glyph {
    font-family: var(--font-glyph);
    font-size: 84px;
  }

  .star {
    animation: twinkle 5s ease-in-out infinite;
    animation-delay: var(--d);
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes spin-reverse {
    to {
      transform: rotate(-360deg);
    }
  }

  @keyframes twinkle {
    0%,
    100% {
      opacity: 0.35;
    }
    50% {
      opacity: 0.8;
    }
  }

  @keyframes sigil-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }

  @keyframes aura-pulse {
    0%,
    100% {
      opacity: 0.55;
      transform: scale(1);
    }
    50% {
      opacity: 0.85;
      transform: scale(1.05);
    }
  }
</style>
