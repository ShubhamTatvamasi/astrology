---
import '@fontsource-variable/space-grotesk';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '../styles/global.css';

import { ClientRouter } from 'astro:transitions';
import Starfield from '../components/Starfield.svelte';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { href } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title = 'Astra — Your sky, decoded',
  description = 'A modern astrology companion. Calculate your birth chart, explore the zodiac, and learn the language of the sky — free, private, and in your browser.',
  image = '/og.png',
  noindex = false,
} = Astro.props;

const fullTitle = title.includes('Astra') ? title : `${title} · Astra`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(href(image), Astro.site);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Astra',
  url: canonical.href,
  description,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#05060d" />
    <meta name="color-scheme" content="dark" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={href('/favicon.svg')} />
    <link rel="icon" type="image/png" sizes="192x192" href={href('/icon-192.png')} />
    <link rel="apple-touch-icon" href={href('/apple-touch-icon.png')} />
    <link rel="manifest" href={href('/site.webmanifest')} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Astra" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Astra — astrology, decoded" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Astra — astrology, decoded" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <ClientRouter />
    <noscript>
      <style>
        .reveal,
        .reveal-scale {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
  </head>
  <body id="top">
    <a class="skip-link" href="#main">Skip to content</a>
    <Starfield client:load />
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script is:inline>
      function initSite() {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        document.querySelectorAll('.reveal, .reveal-scale').forEach(function (el) {
          if (el.dataset.revealBound === '1') return;
          el.dataset.revealBound = '1';
          if (reduce || !('IntersectionObserver' in window)) {
            el.classList.add('is-visible');
            return;
          }
          const observer = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-visible');
                  observer.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.12, rootMargin: '0px 0px -6% 0px' },
          );
          observer.observe(el);
        });

        document.querySelectorAll('.card').forEach(function (card) {
          if (card.dataset.glowBound === '1') return;
          card.dataset.glowBound = '1';
          card.addEventListener(
            'pointermove',
            function (event) {
              const rect = card.getBoundingClientRect();
              card.style.setProperty('--mx', ((event.clientX - rect.left) / rect.width) * 100 + '%');
              card.style.setProperty('--my', ((event.clientY - rect.top) / rect.height) * 100 + '%');
            },
            { passive: true },
          );
        });
      }

      initSite();
      if (!window.__astraSiteLoadBound) {
        window.__astraSiteLoadBound = true;
        document.addEventListener('astro:page-load', initSite);
      }
    </script>
  </body>
</html>
