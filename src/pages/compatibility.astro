---
import BaseLayout from '../layouts/BaseLayout.astro';
import CompatibilityApp from '../components/CompatibilityApp.svelte';
import { href } from '../lib/url';
---

<BaseLayout
  title="Marriage & partnership matching — synastry & Vedic Gun Milan"
  description="Compare two birth charts for marriage and partnership. Western synastry across love, emotion, communication, commitment, and growth, plus a traditional Vedic Ashtakoot Gun Milan layer — free and private."
>
  <section class="match-hero">
    <div class="duo-orbit" aria-hidden="true">
      <span class="ring ring-a"></span>
      <span class="ring ring-b"></span>
      <span class="core">✦</span>
    </div>
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Marriage & partnership</p>
        <h1 class="display h1">
          Two charts.<br />
          <em class="gold">One conversation.</em>
        </h1>
        <p class="lede">
          Compatibility is not a yes-or-no score. Astra compares both birth charts — attraction,
          emotional safety, communication, commitment, and shared direction — then adds a separate
          traditional Vedic Ashtakoot layer for a second lens.
        </p>
        <div class="hero-chips">
          <span class="chip chip--gold">Western synastry</span>
          <span class="chip">Vedic Gun Milan</span>
          <span class="chip">House overlays</span>
          <span class="chip">Private</span>
        </div>
        <div class="hero-actions">
          <a class="btn btn-primary" href="#match-start">Match two charts <span class="arrow">→</span></a>
          <a class="btn btn-ghost" href={href('/learn/#method')}>Our method</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section--tight" id="match-start">
    <div class="container">
      <CompatibilityApp client:load />
    </div>
  </section>

  <section class="section--tight match-method-section" id="match-method">
    <div class="container method-grid">
      <div>
        <p class="kicker">Two lenses</p>
        <h2 class="display method-title">A map,<br /><em class="gold">not a verdict.</em></h2>
        <p class="method-lede">
          No compatibility report can decide a marriage. What it can do is show where two people
          naturally meet, where they will need to work, and what to talk about before the wedding
          invitations go out.
        </p>
      </div>
      <div class="method-facts">
        <div class="method-fact">
          <span class="method-num">01</span>
          <div>
            <h3>Western synastry</h3>
            <p>
              We compare two tropical charts by major aspects across Sun, Moon, Mercury, Venus, Mars,
              Jupiter, Saturn, the outer planets, Node, Ascendant, and Midheaven. Tighter orbs carry
              more weight.
            </p>
          </div>
        </div>
        <div class="method-fact">
          <span class="method-num">02</span>
          <div>
            <h3>Vedic Ashtakoot</h3>
            <p>
              A separate Lahiri sidereal Moon-nakshatra system: Varna, Vashya, Tara, Yoni, Graha
              Maitri, Gana, Bhakoot, and Nadi out of 36. It is role-sensitive and traditional; you can
              switch the bride/groom order.
            </p>
          </div>
        </div>
        <div class="method-fact">
          <span class="method-num">03</span>
          <div>
            <h3>What to do with it</h3>
            <p>
              Read the strongest threads, the growth edges, and the house overlays. Then talk. The
              questions at the end are more useful than any single number.
            </p>
          </div>
        </div>
        <div class="method-actions">
          <a class="btn btn-ghost btn-sm" href={href('/learn/#method')}>Methodology <span class="arrow">→</span></a>
          <a
            class="btn btn-ghost btn-sm"
            href="https://github.com/ShubhamTatvamasi/astrology/blob/main/MATCH_RESEARCH.md"
            target="_blank"
            rel="noopener noreferrer"
          >Full matching research ↗</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .match-hero {
    position: relative;
    padding: 8.8rem 0 2rem;
    overflow: hidden;
  }

  .duo-orbit {
    position: absolute;
    top: 48%;
    right: 2%;
    width: min(520px, 42vw);
    aspect-ratio: 1;
    transform: translateY(-50%);
    pointer-events: none;
    opacity: 0.8;
  }

  .ring {
    position: absolute;
    border: 1px solid var(--line);
    border-radius: 50%;
  }

  .ring-a {
    inset: 8% 20% 20% 8%;
    border-color: var(--gold-line);
    animation: spin 70s linear infinite;
  }

  .ring-b {
    inset: 20% 8% 8% 20%;
    border-color: rgba(109, 75, 214, 0.3);
    animation: spin 55s linear infinite reverse;
  }

  .ring-a::before,
  .ring-b::before,
  .ring-a::after,
  .ring-b::after {
    content: '';
    position: absolute;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--gold);
    box-shadow: 0 0 12px 2px color-mix(in srgb, var(--gold) 45%, transparent);
  }

  .ring-a::before {
    top: 14%;
    right: 18%;
  }

  .ring-b::before {
    bottom: 12%;
    left: 20%;
    background: var(--violet-soft);
    box-shadow: 0 0 12px 2px color-mix(in srgb, var(--violet) 45%, transparent);
  }

  .core {
    position: absolute;
    inset: 42%;
    display: grid;
    place-items: center;
    border: 1px solid var(--gold-line);
    border-radius: 50%;
    background: var(--card-bg);
    color: var(--gold);
    font-size: 1.2rem;
    box-shadow: 0 0 50px -12px var(--gold);
  }

  .hero-grid {
    position: relative;
  }

  .h1 {
    margin-top: 1rem;
    font-size: clamp(3.5rem, 7.4vw, 6.4rem);
  }

  .lede {
    margin-top: 1.2rem;
    max-width: 58ch;
  }

  .hero-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1.3rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.5rem;
  }

  .section--tight {
    padding: clamp(1.5rem, 3vw, 2.5rem) 0 clamp(3rem, 6vw, 4rem);
    scroll-margin-top: 100px;
  }

  .match-method-section {
    border-top: 1px solid var(--line-soft);
  }

  .method-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }

  .method-title {
    margin-top: 0.5rem;
    font-size: clamp(2.2rem, 4.4vw, 3.6rem);
  }

  .method-lede {
    margin-top: 1rem;
    max-width: 42ch;
    font-size: 0.85rem;
    line-height: 1.65;
    color: var(--muted);
  }

  .method-facts {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .method-fact {
    display: flex;
    gap: 0.9rem;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--line-soft);
  }

  .method-num {
    font-family: var(--font-serif);
    color: var(--gold);
    font-size: 0.95rem;
    flex-shrink: 0;
  }

  .method-fact h3 {
    font-size: 0.85rem;
    font-weight: 500;
  }

  .method-fact p {
    margin-top: 0.25rem;
    font-size: 0.73rem;
    line-height: 1.6;
    color: var(--muted);
  }

  .method-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding-top: 0.2rem;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (max-width: 1000px) {
    .duo-orbit {
      right: -22%;
      opacity: 0.4;
    }
    .method-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    .match-hero {
      padding-top: 7.4rem;
    }
    .duo-orbit {
      display: none;
    }
  }
</style>
