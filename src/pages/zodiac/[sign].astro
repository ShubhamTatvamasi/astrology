---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SignSigil from '../../components/SignSigil.astro';
import { SIGNS, type Sign } from '../../data/signs';
import { HOUSES } from '../../data/houses';
import { href } from '../../lib/url';

export function getStaticPaths() {
  return SIGNS.map((sign, index) => ({
    params: { sign: sign.slug },
    props: { sign, index },
  }));
}

interface Props {
  sign: Sign;
  index: number;
}

const { sign, index } = Astro.props;
const prev = SIGNS[(index + 11) % 12]!;
const next = SIGNS[(index + 1) % 12]!;
const house = HOUSES[sign.house - 1]!;
const matches = sign.matches
  .map((match) => ({ ...match, sign: SIGNS.find((s) => s.slug === match.slug)! }))
  .filter((match) => match.sign);
const tension = sign.tension
  .map((item) => ({ ...item, sign: SIGNS.find((s) => s.slug === item.slug)! }))
  .filter((item) => item.sign);

const elementColor: Record<string, string> = {
  Fire: '#ff8a5c',
  Earth: '#7fcf9d',
  Air: '#8fb8ff',
  Water: '#b79dff',
};
const color = elementColor[sign.element]!;

const description = `${sign.name} (${sign.dates}): ${sign.short} Explore ${sign.name}'s element, ruler, love style, career, compatibility, and meaning in the birth chart.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: `${sign.name} — traits, dates, compatibility and meaning`,
  description,
  about: { '@type': 'Thing', name: `${sign.name} zodiac sign` },
  author: { '@type': 'Organization', name: 'Astra' },
};
---

<BaseLayout title={`${sign.name} — traits, dates, compatibility & meaning`} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <article class="sign-page" style={`--c:${color}`}>
    <header class="sign-hero">
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">Zodiac sign · {sign.element} · {sign.modality}</p>
          <div class="title-row">
            <h1 class="display sign-title">{sign.name}</h1>
            <span class="title-glyph glyph" aria-hidden="true">{sign.glyph}</span>
          </div>
          <p class="tagline serif">{sign.tagline}</p>
          <p class="lede">{sign.short}</p>
          <div class="hero-chips">
            <span class="chip chip--gold">{sign.dates}</span>
            <span class="chip"><span class="element-dot" style={`color:${color}`}></span>{sign.element}</span>
            <span class="chip">{sign.modality}</span>
            <span class="chip">{sign.rulerGlyph} {sign.ruler}</span>
            <span class="chip">House {sign.house}</span>
          </div>
          <div class="hero-actions">
            <a class="btn btn-primary" href={href('/chart/')}>Find your {sign.name} placements <span class="arrow">→</span></a>
            <a class="btn btn-ghost" href={href('/zodiac/')}>All twelve signs</a>
          </div>
        </div>
        <div class="hero-art">
          <SignSigil {sign} />
          <p class="sigil-caption">{sign.symbol} · ruled by {sign.ruler}</p>
        </div>
      </div>
    </header>

    <div class="container">
      <div class="rule"></div>
    </div>

    <section class="section--tight">
      <div class="container intro-grid">
        <div class="intro-copy reveal">
          <p class="kicker">The style</p>
          <h2 class="display h2">{sign.keyword.toLowerCase()},<br /><em class="gold">in practice.</em></h2>
          {sign.overview.map((paragraph) => (
            <p class="body-copy">{paragraph}</p>
          ))}
        </div>

        <aside class="facts card reveal" style="--delay:100ms">
          <p class="facts-title">At a glance</p>
          <dl>
            <div><dt>Symbol</dt><dd>{sign.symbol} {sign.glyph}</dd></div>
            <div><dt>Dates</dt><dd>{sign.dates}</dd></div>
            <div><dt>Element</dt><dd><span class="element-dot" style={`color:${color}`}></span> {sign.element}</dd></div>
            <div><dt>Modality</dt><dd>{sign.modality}</dd></div>
            <div><dt>Ruler</dt><dd>{sign.rulerGlyph} {sign.ruler}</dd></div>
            <div><dt>Natural house</dt><dd>{sign.house} · {house.title}</dd></div>
            <div><dt>Keyword</dt><dd>{sign.keyword}</dd></div>
          </dl>
          <p class="facts-note">
            Sign dates shift by a day from year to year. A real birth chart uses the exact degree of
            the Sun, not the calendar range.
          </p>
        </aside>
      </div>
    </section>

    <section class="section--tight">
      <div class="container">
        <div class="duo-grid">
          <div class="duo-card card reveal">
            <p class="kicker">In the light</p>
            <h2 class="duo-title serif">Strengths</h2>
            <ul class="trait-list strength">
              {sign.strengths.map((item) => (
                <li><span aria-hidden="true">✦</span>{item}</li>
              ))}
            </ul>
          </div>
          <div class="duo-card card reveal" style="--delay:80ms">
            <p class="kicker">In the shadow</p>
            <h2 class="duo-title serif">Growth edges</h2>
            <ul class="trait-list shadow">
              {sign.shadow.map((item) => (
                <li><span aria-hidden="true">◐</span>{item}</li>
              ))}
            </ul>
            <p class="duo-note">
              A shadow is not a flaw in the sign. It is the place where its gift gets overused.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="section--tight in-chart-section">
      <div class="container">
        <div class="section-head">
          <div>
            <p class="kicker reveal">In your chart</p>
            <h2 class="display h2 reveal" style="--delay:60ms">One sign,<br /><em class="gold">three jobs.</em></h2>
          </div>
          <p class="lede reveal" style="--delay:120ms">
            The same zodiac sign behaves differently depending on which planet wears it. Here is what
            {sign.name} sounds like as your Sun, your Moon, and your rising sign.
          </p>
        </div>

        <div class="three-grid">
          <article class="chart-card card reveal">
            <div class="chart-card-head">
              <span class="chart-glyph glyph">☉</span>
              <div>
                <p class="chart-label">Sun in {sign.name}</p>
                <p class="chart-sub">Identity & vitality</p>
              </div>
            </div>
            <p>{sign.sun}</p>
          </article>
          <article class="chart-card card reveal" style="--delay:70ms">
            <div class="chart-card-head">
              <span class="chart-glyph glyph" style="color:#d8d6ef">☽</span>
              <div>
                <p class="chart-label">Moon in {sign.name}</p>
                <p class="chart-sub">Emotion & instinct</p>
              </div>
            </div>
            <p>{sign.moon}</p>
          </article>
          <article class="chart-card card reveal" style="--delay:140ms">
            <div class="chart-card-head">
              <span class="chart-glyph glyph" style={`color:${color}`}>{sign.glyph}</span>
              <div>
                <p class="chart-label">{sign.name} rising</p>
                <p class="chart-sub">First impression</p>
              </div>
            </div>
            <p>{sign.rising}</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section--tight">
      <div class="container life-grid">
        <article class="life-card card reveal">
          <span class="life-glyph glyph" aria-hidden="true">♀</span>
          <h2 class="serif">Love</h2>
          <p>{sign.love}</p>
        </article>
        <article class="life-card card reveal" style="--delay:70ms">
          <span class="life-glyph glyph" aria-hidden="true">♄</span>
          <h2 class="serif">Work</h2>
          <p>{sign.career}</p>
        </article>
        <article class="life-card card reveal" style="--delay:140ms">
          <span class="life-glyph glyph" aria-hidden="true">☽</span>
          <h2 class="serif">Friendship</h2>
          <p>{sign.friendship}</p>
        </article>
      </div>
    </section>

    <section class="section--tight">
      <div class="container">
        <div class="section-head">
          <div>
            <p class="kicker reveal">Compatibility</p>
            <h2 class="display h2 reveal" style="--delay:60ms">Easy chemistry.<br /><em class="gold">Honest friction.</em></h2>
          </div>
          <p class="lede reveal" style="--delay:120ms">
            Sun-sign compatibility is a starting point, not a verdict. These are the pairings that
            traditionally click — and the ones that ask for more conscious work.
          </p>
        </div>

        <div class="compat-grid">
          {matches.map((match, i) => (
            <a class="compat-card card reveal" href={href(`/zodiac/${match.sign.slug}/`)} style={`--delay:${i * 60}ms`}>
              <div class="compat-head">
                <span class="compat-glyph glyph" style={`color:${elementColor[match.sign.element]}`}>{match.sign.glyph}</span>
                <div>
                  <p class="chart-label">{sign.name} + {match.sign.name}</p>
                  <p class="chart-sub">{match.sign.element} · {match.sign.modality}</p>
                </div>
              </div>
              <p>{match.why}</p>
              <span class="compat-link">Read {match.sign.name} <span aria-hidden="true">↗</span></span>
            </a>
          ))}
        </div>

        {tension.length > 0 && (
          <div class="tension-row">
            <p class="tension-label">Growth edges</p>
            {tension.map((item) => (
              <p class="tension-item">
                <a href={href(`/zodiac/${item.sign.slug}/`)}>{item.sign.glyph} {item.sign.name}</a>
                — {item.why}
              </p>
            ))}
          </div>
        )}

        <div class="compat-note card">
          <p>
            <strong>Want the real answer?</strong> Relationship astrology compares both charts:
            Moon for emotional needs, Venus for affection, Mars for desire, and the aspects between
            them. A sun-sign match is only the trailer.
          </p>
          <a class="btn btn-ghost btn-sm" href={href('/chart/')}>Compare a real chart <span class="arrow">→</span></a>
        </div>
      </div>
    </section>

    <section class="section--tight">
      <div class="container lucky-grid">
        <div class="lucky-copy reveal">
          <p class="kicker">Correspondences</p>
          <h2 class="display h2">The little<br /><em class="gold">keys.</em></h2>
          <p class="body-copy">
            Traditional correspondences are symbolic anchors, not lucky charms that override free
            will. Use them as reminders of the sign’s texture.
          </p>
        </div>
        <div class="lucky-items">
          <div class="lucky-item card reveal">
            <span class="lucky-label">Colour</span>
            <span class="swatch" style={`background:${sign.lucky.hex}`}></span>
            <strong>{sign.lucky.color}</strong>
          </div>
          <div class="lucky-item card reveal" style="--delay:50ms">
            <span class="lucky-label">Stone</span>
            <span class="lucky-glyph glyph" aria-hidden="true">◈</span>
            <strong>{sign.lucky.stone}</strong>
          </div>
          <div class="lucky-item card reveal" style="--delay:100ms">
            <span class="lucky-label">Day</span>
            <span class="lucky-glyph glyph" aria-hidden="true">☉</span>
            <strong>{sign.lucky.day}</strong>
          </div>
          <div class="lucky-item card reveal" style="--delay:150ms">
            <span class="lucky-label">Number</span>
            <span class="lucky-glyph serif" aria-hidden="true">{sign.lucky.number}</span>
            <strong>{sign.lucky.number}</strong>
          </div>
        </div>
      </div>
    </section>

    <section class="section--tight">
      <div class="container body-card card reveal">
        <div>
          <p class="kicker">Body & rhythm</p>
          <h2 class="serif body-title">The physical signature</h2>
        </div>
        <p>{sign.body}</p>
      </div>
    </section>

    <nav class="container sign-nav" aria-label="Browse zodiac signs">
      <a class="nav-sign" href={href(`/zodiac/${prev.slug}/`)}>
        <span class="nav-dir">← Previous</span>
        <span class="nav-name"><span class="glyph">{prev.glyph}</span> {prev.name}</span>
      </a>
      <a class="nav-all" href={href('/zodiac/')}>All 12 signs</a>
      <a class="nav-sign next" href={href(`/zodiac/${next.slug}/`)}>
        <span class="nav-dir">Next →</span>
        <span class="nav-name">{next.name} <span class="glyph">{next.glyph}</span></span>
      </a>
    </nav>

    <section class="section cta-section">
      <div class="container cta-inner">
        <div>
          <p class="kicker">Where does {sign.name} live in your chart?</p>
          <h2 class="display h2">Find out in<br /><em class="gold">under a minute.</em></h2>
        </div>
        <a class="btn btn-primary" href={href('/chart/')}>Cast your free chart <span class="arrow">→</span></a>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .sign-page {
    padding-top: 8.5rem;
  }

  .sign-hero {
    padding-bottom: 2rem;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
  }

  .title-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 0.8rem;
  }

  .sign-title {
    font-size: clamp(4rem, 9vw, 8rem);
    line-height: 0.85;
  }

  .title-glyph {
    color: var(--c);
    font-size: clamp(2.5rem, 5vw, 4rem);
    filter: drop-shadow(0 0 24px color-mix(in srgb, var(--c) 45%, transparent));
  }

  .tagline {
    margin-top: 0.8rem;
    font-size: clamp(1.3rem, 2vw, 1.7rem);
    font-style: italic;
    color: var(--c);
  }

  .hero-copy .lede {
    margin-top: 0.8rem;
    max-width: 48ch;
  }

  .hero-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1.4rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 1.7rem;
  }

  .hero-art {
    width: 100%;
    max-width: 520px;
    justify-self: end;
  }

  .sigil-caption {
    margin-top: 0.2rem;
    text-align: center;
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .section--tight {
    padding: clamp(3rem, 6vw, 5rem) 0;
  }

  .intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }

  .intro-copy .h2 {
    margin-top: 0.6rem;
    margin-bottom: 1.3rem;
  }

  .body-copy {
    margin-top: 0.8rem;
    font-size: 0.98rem;
    line-height: 1.75;
    color: var(--muted);
    max-width: 60ch;
  }

  .facts {
    padding: 1.5rem;
    position: sticky;
    top: 110px;
  }

  .facts-title {
    font-size: 0.64rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 0.8rem;
  }

  .facts dl {
    display: flex;
    flex-direction: column;
  }

  .facts dl > div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--line-soft);
    font-size: 0.78rem;
  }

  .facts dt {
    color: var(--faint);
    flex-shrink: 0;
  }

  .facts dd {
    margin: 0;
    text-align: right;
    color: var(--ink);
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  .facts-note {
    margin-top: 0.9rem;
    font-size: 0.7rem;
    line-height: 1.5;
    color: var(--faint);
  }

  .duo-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .duo-card {
    padding: 1.5rem;
  }

  .duo-title {
    margin-top: 0.4rem;
    font-size: 2.2rem;
    font-weight: 400;
  }

  .trait-list {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    margin-top: 1rem;
  }

  .trait-list li {
    display: flex;
    gap: 0.55rem;
    align-items: baseline;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .trait-list li span {
    color: var(--gold);
    font-size: 0.65rem;
  }

  .trait-list.shadow li span {
    color: var(--rose);
  }

  .duo-note {
    margin-top: 1.1rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--line-soft);
    font-size: 0.72rem;
    line-height: 1.55;
    color: var(--faint);
  }

  .in-chart-section {
    background: linear-gradient(180deg, transparent, var(--surface), transparent);
  }

  .three-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .chart-card {
    padding: 1.4rem;
    border-top: 1px solid color-mix(in srgb, var(--c) 50%, transparent);
  }

  .chart-card-head {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-bottom: 0.9rem;
  }

  .chart-glyph {
    font-size: 1.7rem;
    color: var(--gold);
  }

  .chart-label {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    line-height: 1.15;
  }

  .chart-sub {
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .chart-card p {
    font-size: 0.82rem;
    line-height: 1.6;
    color: var(--muted);
  }

  .life-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .life-card {
    padding: 1.5rem;
  }

  .life-glyph {
    font-size: 1.4rem;
    color: var(--c);
  }

  .life-card h2 {
    margin-top: 1.4rem;
    font-size: 2rem;
    font-weight: 400;
  }

  .life-card p {
    margin-top: 0.5rem;
    font-size: 0.85rem;
    line-height: 1.65;
    color: var(--muted);
  }

  .compat-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .compat-card {
    padding: 1.35rem;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    transition: transform 0.35s var(--ease), border-color 0.35s ease;
  }

  .compat-card:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--c) 40%, transparent);
  }

  .compat-head {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }

  .compat-glyph {
    font-size: 2rem;
  }

  .compat-card p {
    font-size: 0.82rem;
    line-height: 1.6;
    color: var(--muted);
  }

  .compat-link {
    margin-top: auto;
    padding-top: 0.8rem;
    border-top: 1px solid var(--line-soft);
    font-size: 0.72rem;
    color: var(--gold);
  }

  .tension-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1.4rem;
    margin-top: 1.2rem;
    padding: 1rem 1.2rem;
    border: 1px dashed var(--line);
    border-radius: 16px;
  }

  .tension-label {
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--rose);
  }

  .tension-item {
    font-size: 0.75rem;
    color: var(--faint);
  }

  .tension-item a {
    color: var(--muted);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 3px;
  }

  .compat-note {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    margin-top: 1.2rem;
    padding: 1.2rem 1.4rem;
  }

  .compat-note p {
    max-width: 64ch;
    font-size: 0.78rem;
    line-height: 1.55;
    color: var(--faint);
  }

  .compat-note strong {
    color: var(--muted);
    font-weight: 500;
  }

  .lucky-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .lucky-copy .h2 {
    margin-top: 0.5rem;
    margin-bottom: 1rem;
  }

  .lucky-items {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.8rem;
  }

  .lucky-item {
    padding: 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .lucky-label {
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.17em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .lucky-item strong {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    font-weight: 400;
  }

  .swatch {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    box-shadow: 0 0 24px -4px currentColor;
    border: 1px solid var(--line-strong);
  }

  .lucky-glyph {
    color: var(--gold);
    font-size: 1.4rem;
    line-height: 1.4;
  }

  .body-card {
    display: grid;
    grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
    gap: 2rem;
    align-items: center;
    padding: clamp(1.5rem, 3vw, 2.2rem);
  }

  .body-title {
    margin-top: 0.4rem;
    font-size: 1.8rem;
    font-weight: 400;
  }

  .body-card > p {
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--muted);
  }

  .sign-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--line-soft);
  }

  .nav-sign {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    transition: color 0.2s ease;
  }

  .nav-sign.next {
    text-align: right;
    align-items: flex-end;
